@host = http://localhost:5105

### Register
POST {{host}}/api/auth/register
Content-Type: application/json

{
  "username": "melek",
  "email": "melek@example.com",
  "password": "123456"
}

### Login
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "username": "melek",
  "password": "123456"
}
